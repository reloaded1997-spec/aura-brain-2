# -----------------------------------------------------------------------------
# Firebase web config. Copy this file to `.env` and fill in real values from
# Firebase Console -> Project settings -> Your apps -> SDK setup/config.
# Vite only exposes vars prefixed with VITE_ to the client.
# DO NOT commit your real .env — it is gitignored.
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890

# Firebase Cloud Messaging VAPID key for push notifications.
# Get it from Firebase Console → Project settings → Cloud Messaging →
# Web Push certificates → Generate key pair → copy the "Key pair" value.
VITE_FCM_VAPID_KEY="BIM5d809RVPFbqvXGk5dK1JABxFs2JHs0xfKdcB6rZb3Bs_b1FR69-RgTxyHmcdYaXGzErVZzT_iInE3SGqdB8Y"
